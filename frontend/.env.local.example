# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# Variables prefixed NEXT_PUBLIC_* are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL for real-time incident feeds.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Base URL of the Chaos Service for triggering demo incidents.
NEXT_PUBLIC_CHAOS_SERVICE_URL=http://localhost:8001
